# ConnectLAW – Konfiguration
# Kopiere diese Datei nach ".env" und trage deinen API-Schlüssel ein.

# Pflicht: Anthropic API-Schlüssel
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Modell (Standard: claude-opus-4-8)
# CONNECTLAW_MODEL=claude-opus-4-8

# Optional: Denk-/Aufwandsstufe – low | medium | high | max
# CONNECTLAW_EFFORT=high

# Optional: maximale Antwort-Tokens (Standard: 16000)
# CONNECTLAW_MAX_TOKENS=16000

# Optional: Live-Websuche aktivieren (Standard: true)
# CONNECTLAW_WEB_SEARCH=true

# Optional: Diagnose-Ausgaben (Cache-/Token-Nutzung) – true | false
# CONNECTLAW_VERBOSE=false

# --- Nur für das Web-Frontend / Docker-Deployment -------------------------
# CORS: erlaubte Herkunft der Chat-Seite (GitHub-Pages-Domain, ohne Pfad)
# CONNECTLAW_CORS_ORIGINS=https://acortese-wq.github.io

# Domain für automatisches HTTPS (Caddy). DNS muss auf den Server zeigen.
# DOMAIN=connectlaw.example.com
